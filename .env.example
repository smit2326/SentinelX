# Backend API Settings
PROJECT_NAME="SENTINEL-X Security Platform"
PROJECT_VERSION="1.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="your-secret-jwt-key-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL="sqlite+aiosqlite:///./sentinel_x.db"
DEFAULT_SUBNET="192.168.1.0/24"
SIMULATION_ENABLED=true
SIMULATION_INTERVAL_SECONDS=15

# Frontend Vite Settings
VITE_API_URL="http://localhost:8000/api/v1"
VITE_WS_URL="ws://localhost:8000/api/v1/ws/telemetry"
