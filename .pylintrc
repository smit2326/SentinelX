[MAIN]
init-hook='import sys; sys.path.extend(["backend", "."])'
ignore=dist,node_modules,storage,pcaps
jobs=0
fail-under=8.5

[MESSAGES CONTROL]
disable=
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    too-few-public-methods,
    too-many-arguments,
    too-many-positional-arguments,
    too-many-locals,
    too-many-branches,
    too-many-statements,
    too-many-instance-attributes,
    too-many-nested-blocks,
    broad-exception-caught,
    unused-argument,
    redefined-outer-name,
    duplicate-code,
    import-outside-toplevel,
    line-too-long,
    trailing-whitespace,
    no-else-return,
    no-else-break,
    consider-using-in,
    raise-missing-from,
    subprocess-run-check,
    logging-fstring-interpolation,
    wrong-import-order,
    wrong-import-position,
    ungrouped-imports,
    multiple-statements,
    not-callable,
    unused-variable,
    unused-import,
    invalid-name,
    global-statement

[FORMAT]
max-line-length=120
max-module-lines=1000

[SIMILARITIES]
min-similarity-lines=15
ignore-comments=yes
ignore-docstrings=yes
ignore-imports=yes
